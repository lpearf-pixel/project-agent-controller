# Copy this file outside Git, replace every placeholder, then chmod 600.
PAC_DATA_DIR=replace-with-absolute-data-directory
PAC_PROJECTS_FILE=replace-with-absolute-projects-file
PAC_SCM_PROVIDERS_FILE=replace-with-absolute-scm-providers-file
PAC_KNOWLEDGE_DIR=replace-with-absolute-private-knowledge-directory
PAC_LOCAL_SOURCES_ROOT=replace-with-absolute-sources-root
PAC_LOCAL_REPOS_ROOT=replace-with-absolute-repositories-root
PAC_DOCKER_SOCKET=replace-with-absolute-docker-socket
PAC_GIT_EXECUTABLE=replace-with-absolute-git-executable
PAC_HOST=127.0.0.1
PAC_PORT=9090
PAC_POLL_INTERVAL_SECONDS=5
PAC_GITHUB_TOKEN=replace-with-read-only-token

# Optional proxy values. Keep only the entries needed on the host.
HTTP_PROXY=http://127.0.0.1:8001
HTTPS_PROXY=http://127.0.0.1:8001
NO_PROXY=localhost,127.0.0.1,::1
